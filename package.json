{
  "name": "tsb-frontend",
  "private": true,
  "workspaces": [
    "layers/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev -w tokyosushi",
    "build": "npm run build -w tokyosushi",
    "generate": "npm run generate -w tokyosushi",
    "preview": "npm run preview -w tokyosushi",
    "lint": "vp lint && node scripts/check-ssr-safety.mjs && node scripts/check-engine-boundaries.mjs && node scripts/check-locale-parity.mjs && node scripts/check-hardcoded-phone.mjs && node scripts/check-focus-ring-contrast.mjs && node scripts/check-token-contrast.mjs",
    "check": "vp check && node scripts/check-ssr-safety.mjs && node scripts/check-engine-boundaries.mjs && node scripts/check-locale-parity.mjs && node scripts/check-hardcoded-phone.mjs && node scripts/check-focus-ring-contrast.mjs && node scripts/check-token-contrast.mjs",
    "fmt": "vp fmt",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "npm run test:e2e:all",
    "test:e2e:tsb": "npm run test:e2e -w tokyosushi",
    "test:e2e:ygf": "npm run test:e2e -w ygfliege",
    "test:e2e:all": "npm run test:e2e:tsb; tsb=$?; npm run test:e2e:ygf && exit $tsb",
    "test:visual": "npm run test:visual -w tokyosushi; tsb=$?; npm run test:visual -w ygfliege && exit $tsb",
    "test:visual:update": "npm run test:visual:update -w tokyosushi; tsb=$?; npm run test:visual:update -w ygfliege && exit $tsb",
    "prepare": "vp config"
  },
  "dependencies": {
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/sitemap": "^8.6.1",
    "@pinia/nuxt": "^1.0.2",
    "@sentry/nuxt": "^11.0.0",
    "@vueuse/core": "^15.0.0",
    "graphql": "^17.0.2",
    "graphql-ws": "^6.2.2",
    "libphonenumber-js": "^1.13.14",
    "nuxt": "^4.5.2",
    "oidc-client-ts": "^3.5.0",
    "pinia-plugin-persistedstate": "^4.7.1"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.3.3",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "jiti": "^2.7.0",
    "oxc-parser": "^0.141.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vite-plus": "1.0.0",
    "vue-tsc": "^3.3.11"
  },
  "optionalDependencies": {
    "@esbuild/linux-arm64": "^0.28.2",
    "@esbuild/linux-x64": "^0.28.2",
    "@oxc-minify/binding-linux-arm64-gnu": "^0.151.0",
    "@oxc-minify/binding-linux-x64-gnu": "^0.151.0",
    "@oxc-parser/binding-linux-arm64-gnu": "^0.151.0",
    "@oxc-parser/binding-linux-x64-gnu": "^0.151.0",
    "@oxc-transform/binding-linux-arm64-gnu": "^0.151.0",
    "@oxc-transform/binding-linux-x64-gnu": "^0.151.0",
    "@rollup/rollup-linux-arm64-gnu": "^4.63.6",
    "@rollup/rollup-linux-x64-gnu": "^4.63.6",
    "@tailwindcss/oxide-linux-arm64-gnu": "^4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "lightningcss-linux-arm64-gnu": "^1.33.0",
    "lightningcss-linux-x64-gnu": "^1.33.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^12.2.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "esbuild": true
  }
}
