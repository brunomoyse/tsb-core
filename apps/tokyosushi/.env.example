# REQUIRED for a production build (they are baked into the client bundle; the build fails without them):
# BASE_URL, API_BASE_URL, S3_BUCKET_URL, GRAPHQL_WS_URL, ZITADEL_AUTHORITY, ZITADEL_CLIENT_ID.
BASE_URL=
API_BASE_URL=
# Public base URL of the product photo bucket (also allowed by the CSP `img-src`), no trailing slash.
S3_BUCKET_URL=
GRAPHQL_WS_URL=
UMAMI_HOST=https://analytics.nuagemagique.dev
UMAMI_WEBSITE_ID=

# Cloudflare Turnstile
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# Zitadel OIDC (ZITADEL_AUTHORITY and ZITADEL_CLIENT_ID are required for a production build)
ZITADEL_AUTHORITY=https://auth.tokyosushibarliege.be
ZITADEL_CLIENT_ID=
ZITADEL_NATIVE_CLIENT_ID=

# E2E Testing (Playwright)
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=
