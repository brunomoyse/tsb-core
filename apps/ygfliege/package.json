{
  "name": "ygfliege",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "vp lint . && node ../../scripts/check-ssr-safety.mjs && node ../../scripts/check-engine-boundaries.mjs",
    "test:e2e": "playwright test",
    "test:e2e:mock": "playwright test -c playwright.mock.config.ts",
    "test:e2e:mock:desktop": "playwright test -c playwright.mock.config.ts --project=brand-desktop --project=engine-desktop",
    "test:e2e:mock:mobile": "playwright test -c playwright.mock.config.ts --project=brand-mobile --project=engine-mobile",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots"
  }
}
